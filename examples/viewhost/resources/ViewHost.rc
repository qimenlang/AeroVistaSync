// viewhost 对话框资源（MFC）。
#include "resource.h"
// afxres.h → winres.h → commctrl.rh 已提供 TVS_*。不要 #include <commctrl.h>：
// 那是 C++ 头，VS 资源视图解析 winnt.h 等会长符号，报 RC2247。
#define APSTUDIO_HIDDEN_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_HIDDEN_SYMBOLS

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_VIEWHOST_DIALOG DIALOGEX 0, 0, 340, 360
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AeroVista viewhost"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "连接状态", IDC_STATIC, 8, 8, 324, 60
    LTEXT           "Ready IG: 0", IDC_STATUS_READY, 16, 22, 200, 10
    LTEXT           "IGCtrl 发送: 0", IDC_STATUS_IGCTRL, 16, 36, 200, 10
    LTEXT           "SOF 接收: 0", IDC_STATUS_SOF, 16, 50, 200, 10

    GROUPBOX        "眼点 (LLA)", IDC_STATIC, 8, 76, 324, 76
    LTEXT           "lat: -", IDC_EYE_LAT, 16, 90, 300, 10
    LTEXT           "lon: -", IDC_EYE_LON, 16, 104, 300, 10
    LTEXT           "alt: -", IDC_EYE_ALT, 16, 118, 300, 10
    LTEXT           "yaw: -  pitch: -  roll: -", IDC_EYE_YPR, 16, 132, 300, 10

    GROUPBOX        "场景", IDC_STATIC, 8, 160, 324, 112
    CONTROL         "", IDC_ENTITY_TREE, "SysTreeView32", WS_BORDER | WS_TABSTOP | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 16, 174, 308, 78
    LTEXT           "单击 eyePoint 控制眼点；单击其它项停止。双击实体打开属性。", IDC_STATUS_ENTITY, 16, 256, 300, 10

    GROUPBOX        "报文自检", IDC_STATIC, 8, 280, 324, 60
    PUSHBUTTON      "testtcp", IDC_TEST_TCP, 16, 294, 60, 14
    PUSHBUTTON      "testudp", IDC_TEST_UDP, 84, 294, 60, 14
    LTEXT           "最近测试: -", IDC_STATUS_TEST, 16, 314, 210, 10
    LTEXT           "最近接收: -", IDC_STATUS_RECV, 16, 330, 210, 10
    DEFPUSHBUTTON   "退出(&X)", IDC_EXIT, 276, 338, 50, 14
END

IDD_ENTITY_PROP DIALOGEX 0, 0, 232, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "实体属性"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "id", IDC_STATIC, 8, 10, 40, 10
    EDITTEXT        IDC_PROP_ID, 56, 8, 60, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "name", IDC_STATIC, 8, 26, 40, 10
    EDITTEXT        IDC_PROP_NAME, 56, 24, 168, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "state", IDC_STATIC, 8, 42, 40, 10
    COMBOBOX        IDC_PROP_STATE, 56, 40, 80, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "alpha", IDC_STATIC, 8, 58, 40, 10
    EDITTEXT        IDC_PROP_ALPHA, 56, 56, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "lat", IDC_STATIC, 8, 74, 40, 10
    EDITTEXT        IDC_PROP_LAT, 56, 72, 80, 12, ES_AUTOHSCROLL
    LTEXT           "lon", IDC_STATIC, 8, 90, 40, 10
    EDITTEXT        IDC_PROP_LON, 56, 88, 80, 12, ES_AUTOHSCROLL
    LTEXT           "alt", IDC_STATIC, 8, 106, 40, 10
    EDITTEXT        IDC_PROP_ALT, 56, 104, 80, 12, ES_AUTOHSCROLL
    LTEXT           "yaw", IDC_STATIC, 8, 122, 40, 10
    EDITTEXT        IDC_PROP_YAW, 56, 120, 80, 12, ES_AUTOHSCROLL
    LTEXT           "pitch", IDC_STATIC, 8, 138, 40, 10
    EDITTEXT        IDC_PROP_PITCH, 56, 136, 80, 12, ES_AUTOHSCROLL
    LTEXT           "roll", IDC_STATIC, 8, 154, 40, 10
    EDITTEXT        IDC_PROP_ROLL, 56, 152, 80, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Apply", IDC_PROP_APPLY, 56, 174, 50, 14
    PUSHBUTTON      "重置", IDC_PROP_RESET, 114, 174, 50, 14
END
