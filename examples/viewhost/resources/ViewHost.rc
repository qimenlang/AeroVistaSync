// viewhost 对话框资源（MFC）。
#include "resource.h"
#include "afxres.h"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_VIEWHOST_DIALOG DIALOGEX 0, 0, 340, 344
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AeroVista viewhost"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "开始控制", IDC_TOGGLE_CONTROL, 200, 8, 70, 14

    GROUPBOX        "连接状态", IDC_STATIC, 8, 28, 324, 60
    LTEXT           "Ready IG: 0", IDC_STATUS_READY, 16, 42, 200, 10
    LTEXT           "IGCtrl 发送: 0", IDC_STATUS_IGCTRL, 16, 56, 200, 10
    LTEXT           "SOF 接收: 0", IDC_STATUS_SOF, 16, 70, 200, 10

    GROUPBOX        "眼点 (LLA)", IDC_STATIC, 8, 96, 324, 76
    LTEXT           "lat: -", IDC_EYE_LAT, 16, 110, 300, 10
    LTEXT           "lon: -", IDC_EYE_LON, 16, 124, 300, 10
    LTEXT           "alt: -", IDC_EYE_ALT, 16, 138, 300, 10
    LTEXT           "yaw: -  pitch: -  roll: -", IDC_EYE_YPR, 16, 152, 300, 10

    GROUPBOX        "实体摆放 (LLA → Detach)", IDC_STATIC, 8, 180, 324, 92
    LTEXT           "Entity ID", IDC_STATIC, 16, 194, 40, 10
    EDITTEXT        IDC_ENTITY_ID, 64, 192, 40, 12, ES_AUTOHSCROLL
    LTEXT           "lat", IDC_STATIC, 110, 194, 20, 10
    EDITTEXT        IDC_ENTITY_LAT, 134, 192, 60, 12, ES_AUTOHSCROLL
    LTEXT           "lon", IDC_STATIC, 200, 194, 20, 10
    EDITTEXT        IDC_ENTITY_LON, 224, 192, 60, 12, ES_AUTOHSCROLL
    LTEXT           "alt", IDC_STATIC, 16, 212, 20, 10
    EDITTEXT        IDC_ENTITY_ALT, 40, 210, 60, 12, ES_AUTOHSCROLL
    LTEXT           "yaw pitch roll", IDC_STATIC, 110, 212, 70, 10
    EDITTEXT        IDC_ENTITY_YPR, 184, 210, 100, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "摆放", IDC_ENTITY_PLACE, 280, 210, 44, 14
    LTEXT           "最近摆放: -", IDC_STATUS_PLACE, 16, 230, 300, 10

    GROUPBOX        "报文自检", IDC_STATIC, 8, 280, 324, 60
    PUSHBUTTON      "testtcp", IDC_TEST_TCP, 16, 294, 60, 14
    PUSHBUTTON      "testudp", IDC_TEST_UDP, 84, 294, 60, 14
    LTEXT           "最近测试: -", IDC_STATUS_TEST, 16, 314, 210, 10
    LTEXT           "最近接收: -", IDC_STATUS_RECV, 16, 330, 210, 10
    DEFPUSHBUTTON   "退出(&X)", IDC_EXIT, 276, 322, 50, 14
END
